[Unit]
Description=Mount OneDrive with rclone
After=graphical-session.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=-/bin/fusermount3 -uz /OneDrive
ExecStartPre=/usr/bin/mkdir -p /OneDrive
ExecStart=/usr/bin/rclone mount onedrive: /OneDrive --vfs-cache-mode writes --dir-cache-time 72h --poll-interval 1m --log-level INFO --rc --rc-addr 127.0.0.1:5572 --rc-no-auth --rc-web-gui
ExecStop=/bin/fusermount3 -u /OneDrive
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
